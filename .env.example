# Copy to .env (never commit the real one). All values are optional —
# without them Runova runs in local/demo mode.

# PostgreSQL (Railway: Postgres service → Variables)
# - Backend hosted ON Railway: use the internal DATABASE_URL / reference ${{Postgres.DATABASE_URL}}
# - Backend on your laptop: use DATABASE_PUBLIC_URL (*.proxy.rlwy.net) instead
DATABASE_URL=postgresql://postgres:CHANGE_ME@postgres.railway.internal:5432/railway

# Meta AI (enables real LLM instead of local heuristics)
MODEL_API_KEY=
META_MODEL=muse-spark-1.1

# Auth token signing (set a long random string in production)
SESSION_SECRET=change-me-in-production

PORT=5173
